# Copiar este archivo como .env.local y completar con los datos de tu proyecto de
# Supabase (Project Settings > API). .env.local NO se sube a git.

# URL del proyecto, por ejemplo https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# Clave pública ("anon" / "publishable"). NO usar la clave "service_role".
VITE_SUPABASE_ANON_KEY=

# Dirección pública del sitio, sin barra final (por ejemplo https://ipponia.tu-subdominio.workers.dev).
# Solo se usa en la compilación, para la imagen que se ve al compartir el enlace. Se carga en Cloudflare
# como variable de compilación (ver CLOUDFLARE.md); en tu computadora no hace falta.
VITE_SITE_URL=
